# ============================================================
# AutoReport — Variables d'environnement (copiez ce fichier en .env)
# ============================================================
# NE COMMITEZ JAMAIS LE FICHIER .env — il contient des secrets !
# ============================================================

# --- BASE DE DONNÉES (OBLIGATOIRE) ---
# Votre URL PostgreSQL Hostinger ou Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- APPLICATION (OBLIGATOIRE) ---
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://votre-domaine.com

# --- SÉCURITÉ SESSIONS (OBLIGATOIRE) ---
# Générez une chaîne aléatoire longue : openssl rand -hex 64
SESSION_SECRET=CHANGEZ_MOI_VALEUR_ALEATOIRE_LONGUE_64_CHARS

# --- PANEL ADMIN (OBLIGATOIRE) ---
# Identifiants de connexion au panel /panel
PANEL_ADMIN_EMAIL=admin@autoreport.com
PANEL_ADMIN_PASSWORD=AutoReport2024!
# Générez : openssl rand -hex 32
PANEL_JWT_SECRET=CHANGEZ_MOI_VALEUR_ALEATOIRE_32_CHARS

# --- IA GEMINI (OBLIGATOIRE pour les rapports IA) ---
# Obtenez votre clé sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
# Si vous utilisez le proxy Replit (laisser vide si non applicable)
# AI_INTEGRATIONS_GEMINI_BASE_URL=
# AI_INTEGRATIONS_GEMINI_API_KEY=

# --- STRIPE (pour les paiements en ligne) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLIC_KEY=pk_live_...

# --- CLOUDFLARE R2 (stockage fichiers cloud - recommandé) ---
# Laissez vide pour utiliser le stockage local /uploads/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- TWILIO (SMS - optionnel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- RESEND (emails - optionnel) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@votre-domaine.com

# --- MINDEE (OCR - optionnel) ---
MINDEE_API_KEY=

# --- PLAID (banque - optionnel) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# --- SAUVEGARDE AUTOMATIQUE (optionnel) ---
BACKUP_EMAIL=votre@email.com

# --- MODE MAINTENANCE (optionnel) ---
# Passez à "true" pour activer la page de maintenance
MAINTENANCE_MODE=false

# --- CORS (optionnel) ---
# Domaines autorisés séparés par des virgules
# CORS_ALLOWED_ORIGINS=https://votre-domaine.com
