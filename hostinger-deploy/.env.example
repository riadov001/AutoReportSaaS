# ================================================================
# AutoReport — Variables d'environnement (Frontend Hostinger)
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS commiter le fichier .env dans git
# ================================================================

# ── Serveur ──────────────────────────────────────────────────────
NODE_ENV=production

# Port d'écoute du serveur Node.js (Hostinger Business : 3000)
PORT=3000

# ── URL du backend distant (OBLIGATOIRE) ─────────────────────────
# L'URL de votre application Replit déployée (sans slash final)
# Toutes les requêtes /api/* et /panel/* seront proxiées vers cette URL
PUBLIC_BASE_URL=https://auto-report.replit.app
