# ================================================================
# AutoReport — Variables d'environnement (PRODUCTION)
# Copiez ce fichier en .env et remplissez toutes les valeurs
# NE JAMAIS commiter le fichier .env dans git
# ================================================================

# ── Application ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://votre-domaine.com

# ── Base de données (Neon PostgreSQL recommandé) ─────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Sessions ─────────────────────────────────────────────────────
# Générez avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=REMPLACEZ_PAR_UNE_CHAINE_ALEATOIRE_DE_64_CHARS

# ── Panel Admin JWT ──────────────────────────────────────────────
# Générez avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANEL_JWT_SECRET=REMPLACEZ_PAR_UNE_CHAINE_ALEATOIRE_DE_32_CHARS

# Identifiants du panel admin (URL : /panel)
PANEL_ADMIN_EMAIL=admin@autoreport.com
PANEL_ADMIN_PASSWORD=MotDePasseSuperSecure2026!

# ── IA Gemini (Google AI) ────────────────────────────────────────
GEMINI_API_KEY=AIza...votre_cle_gemini

# ── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=re_...votre_cle_resend
EMAIL_FROM=noreply@votre-domaine.com

# ── Stripe Paiements ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Stockage Cloudflare R2 (optionnel, sinon uploads local) ─────
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# ── OCR Mindee (optionnel) ───────────────────────────────────────
MINDEE_API_KEY=

# ── SMS Twilio (optionnel) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Plaid Banque (optionnel) ─────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# ── Chiffrement AES (optionnel) ──────────────────────────────────
CRYPTO_SECRET_KEY=

# ── Mode maintenance (true = site en maintenance) ───────────────
MAINTENANCE_MODE=false
